# Copy this file to .env and replace the SMTP placeholders.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your-account@example.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=your-account@example.com

# Leave empty to use data/.log_key, or generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode('ascii'))"
AGENCY_LOG_KEY=

# Optional. Relative paths start at the directory containing todo_manager.py.
# TODO_DATA_DIR=data
